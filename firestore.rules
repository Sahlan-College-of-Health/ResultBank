rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // BASIC AUTHENTICATION
    // ==========================================

    function signedIn() {
      return request.auth != null;
    }

    function userDocumentExists() {
      return signedIn() &&
        exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        );
    }

    function currentUserIsAdmin() {
      return userDocumentExists() &&
        get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == "admin";
    }

    function currentUserIsStudent() {
      return userDocumentExists() &&
        get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == "student";
    }


    // ==========================================
    // USERS
    // ==========================================

    match /users/{userId} {

      // IMPORTANT:
      // A user can always read their own profile.
      allow read: if signedIn() &&
                  request.auth.uid == userId;

      // Admin can read any user profile.
      allow read: if currentUserIsAdmin();

      // Only admin can create/update/delete user profiles.
      allow create, update, delete: if currentUserIsAdmin();
    }


    // ==========================================
    // STUDENTS
    // ==========================================

    match /students/{studentId} {

      allow read: if currentUserIsAdmin()
        || (
          currentUserIsStudent()
          &&
          get(
            /databases/$(database)/documents/users/$(request.auth.uid)
          ).data.studentId == studentId
        );

      allow create, update, delete: if currentUserIsAdmin();
    }


    // ==========================================
    // RESULTS
    // ==========================================

    match /results/{resultId} {

      allow read: if currentUserIsAdmin()
        || (
          currentUserIsStudent()
          &&
          resource.data.studentId ==
            get(
              /databases/$(database)/documents/users/$(request.auth.uid)
            ).data.studentId
          &&
          get(
            /databases/$(database)/documents/students/$(get(
              /databases/$(database)/documents/users/$(request.auth.uid)
            ).data.studentId)
          ).data.resultLocked != true
        );

      allow create, update, delete: if currentUserIsAdmin();
    }


    // ==========================================
    // COURSES
    // ==========================================

    match /courses/{courseId} {

      allow read, create, update, delete:
        if currentUserIsAdmin();
    }


    // ==========================================
    // SESSIONS
    // ==========================================

    match /sessions/{sessionId} {

      allow read, create, update, delete:
        if currentUserIsAdmin();
    }


    // ==========================================
    // SETTINGS
    // ==========================================

    match /settings/{settingId} {

      // Logged-in users can read settings.
      allow read: if signedIn();

      allow create, update, delete:
        if currentUserIsAdmin();
    }


    // ==========================================
    // STUDENT CREDENTIALS
    // ==========================================

    match /studentCredentials/{studentId} {

      allow read, create, update, delete:
        if currentUserIsAdmin();
    }


    // ==========================================
    // CARRY-OVER APPLICATIONS
    // ==========================================

    match /carryOverApplications/{applicationId} {

      allow read: if currentUserIsAdmin()
        || (
          currentUserIsStudent()
          &&
          resource.data.studentId ==
            get(
              /databases/$(database)/documents/users/$(request.auth.uid)
            ).data.studentId
        );

      allow create: if currentUserIsStudent()
        &&
        request.resource.data.studentId ==
          get(
            /databases/$(database)/documents/users/$(request.auth.uid)
          ).data.studentId
        &&
        request.resource.data.status == "Pending";

      allow update, delete:
        if currentUserIsAdmin();
    }


    // ==========================================
    // DENY EVERYTHING ELSE
    // ==========================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
