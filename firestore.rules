rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasUserProfile() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return hasUserProfile() && userProfile().role == "admin";
    }

    function isStudent() {
      return hasUserProfile() && userProfile().role == "student";
    }

    function ownsStudent(studentId) {
      return isStudent() && userProfile().studentId == studentId;
    }

    match /students/{studentId} {
      allow read: if isAdmin() || ownsStudent(studentId);
      allow create, update, delete: if isAdmin();
    }

    match /results/{resultId} {
      allow read: if isAdmin() ||
        (isStudent() && resource.data.studentId == userProfile().studentId);
      allow create, update, delete: if isAdmin();
    }

    match /courses/{courseId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /sessions/{sessionId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow create, update, delete: if isAdmin();
    }

    match /carryOverApplications/{applicationId} {
      allow read: if isAdmin() ||
        (isStudent() && resource.data.studentId == userProfile().studentId);

      allow create: if isStudent() &&
        request.resource.data.studentId == userProfile().studentId &&
        request.resource.data.status == "Pending";

      allow update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
