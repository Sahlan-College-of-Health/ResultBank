rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userProfile() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data;
    }

    function hasUserProfile() {
      return signedIn() &&
        exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        );
    }

    function isAdmin() {
      return hasUserProfile() &&
        userProfile().role == "admin";
    }

    function isStudent() {
      return hasUserProfile() &&
        userProfile().role == "student";
    }

    function ownsStudent(studentId) {
      return isStudent() &&
        userProfile().studentId == studentId;
    }

    function studentResultAccess(studentId) {
      return exists(
        /databases/$(database)/documents/students/$(studentId)
      ) &&
      get(
        /databases/$(database)/documents/students/$(studentId)
      ).data.resultLocked != true;
    }


    // =========================
    // STUDENTS
    // =========================

    match /students/{studentId} {

      allow read: if isAdmin() || ownsStudent(studentId);

      allow create, update, delete: if isAdmin();
    }


    // =========================
    // RESULTS
    // =========================

    match /results/{resultId} {

      allow read: if isAdmin() ||
        (
          isStudent() &&
          resource.data.studentId == userProfile().studentId &&
          studentResultAccess(userProfile().studentId)
        );

      allow create, update, delete: if isAdmin();
    }


    // =========================
    // COURSES
    // =========================

    match /courses/{courseId} {

      allow read, create, update, delete: if isAdmin();
    }


    // =========================
    // SESSIONS
    // =========================

    match /sessions/{sessionId} {

      allow read, create, update, delete: if isAdmin();
    }


    // =========================
    // SETTINGS
    // =========================

    match /settings/{settingId} {

      allow read: if signedIn();

      allow create, update, delete: if isAdmin();
    }


    // =========================
    // USERS
    // =========================

    match /users/{userId} {

      // A logged-in user can ALWAYS read their own
      // user profile.
      allow read: if signedIn() &&
        request.auth.uid == userId;

      // Administrators can read other user profiles.
      allow read: if isAdmin();

      // Only administrators can create/update/delete
      // user profiles.
      allow create, update, delete: if isAdmin();
    }


    // =========================
    // STUDENT CREDENTIALS
    // =========================

    match /studentCredentials/{studentId} {

      allow read, create, update, delete: if isAdmin();
    }


    // =========================
    // CARRY-OVER APPLICATIONS
    // =========================

    match /carryOverApplications/{applicationId} {

      allow read: if isAdmin() ||
        (
          isStudent() &&
          resource.data.studentId == userProfile().studentId &&
          studentResultAccess(userProfile().studentId)
        );

      allow create: if isStudent() &&
        request.resource.data.studentId == userProfile().studentId &&
        request.resource.data.status == "Pending" &&
        studentResultAccess(userProfile().studentId);

      allow update, delete: if isAdmin();
    }


    // =========================
    // DENY EVERYTHING ELSE
    // =========================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
